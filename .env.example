# Copy to .env and fill in. .env is gitignored; never commit real credentials.
#
# Neon gives you a URL starting with `postgresql://`. SQLAlchemy needs the
# driver named explicitly, so change that prefix to `postgresql+psycopg://`.
# Use the POOLED connection string (the host contains "-pooler").
MEAL_PLANNER_DB_URL=postgresql+psycopg://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Leave unset to use the local SQLite file at data/data.db.
